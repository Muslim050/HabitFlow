    },
    "Any days you like, as long as the count adds up. Streaks count periods, not days.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В любые дни, лишь бы набралось нужное число. Серия считается периодами, а не днями."
          }
        }
      }
    },
