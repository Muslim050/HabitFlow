    "A late night still belongs to the previous day until this hour. Sleep is counted around it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поздняя ночь относится к предыдущему дню до этого часа. Сон считается вокруг него."
          }
        }
      }
    },
    "A streak survives this many misses in any 7 scheduled days.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Серия выживает при таком числе пропусков за любые 7 плановых дней."
          }
        }
      }
    },
    "A workout of at least %lld min": {
      "localizations": {
        "ru": {
