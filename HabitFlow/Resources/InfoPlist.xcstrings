        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HabitFlow"
          }
        }
      }
    },
    "CFBundleName": {
      "comment": "Bundle name",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "HabitFlow"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HabitFlow"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "comment": "Privacy - Calendars Full Access Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "HabitFlow shows today's events under your habits, and can add an event you create here straight to your calendar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HabitFlow показывает события на сегодня под привычками, чтобы день читался одним списком. События только читаются и не изменяются."
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "comment": "Privacy - Health Share Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "HabitFlow reads your steps, sleep, workouts, mindful minutes, water and energy from Health to mark habits as done automatically. Nothing leaves your device."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HabitFlow читает шаги, сон, тренировки, минуты осознанности, воду и энергию из Здоровья, чтобы отмечать привычки автоматически. Данные не покидают устройство."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "comment": "Privacy - Health Update Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Debug builds write sample data to Health so you can test automatic tracking in the Simulator."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Отладочные сборки записывают тестовые данные в Здоровье, чтобы проверять авто-трекинг в симуляторе."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "comment": "Privacy - Location Always and When In Use Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Allow location in the background so HabitFlow can mark a place-based habit done even when the app is closed. Locations are never uploaded."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Разрешите геолокацию в фоне, чтобы HabitFlow отмечал гео-привычку даже при закрытом приложении. Геолокация никуда не отправляется."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "comment": "Privacy - Location When In Use Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "HabitFlow uses your location to notice when you arrive at places you chose, such as your gym, and mark that habit done."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HabitFlow использует геолокацию, чтобы замечать, когда вы приходите в выбранные места, например в зал, и отмечать привычку."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "comment": "Privacy - Reminders Full Access Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "HabitFlow shows reminders due today under your habits, can tick one off, and can add a reminder you create here."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "HabitFlow показывает напоминания, срок которых сегодня, под привычками и может отметить напоминание выполненным по нажатию."
          }
        }
      }
    }
  },
  "version": "1.0"
}
